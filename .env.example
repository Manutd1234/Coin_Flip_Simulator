# Copy this file to .env and paste your real keys locally.
# Do not commit or share .env.

# X / Twitter API v2 bearer token for recent search.
X_BEARER_TOKEN=

# Optional Hugging Face token if the model requires authenticated download.
HF_TOKEN=

# Optional Kaggle credentials. Use these with Kaggle CLI/download steps.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local folder containing Transfermarkt CSVs:
# players.csv, appearances.csv, games.csv, clubs.csv, competitions.csv.
PLAYER_DATA_DIR=data/transfermarkt

# Sentiment model for local Transformers.
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
ENABLE_TRANSFORMERS=1

# Live match query and refresh cadence.
DEFAULT_MATCH_QUERY=("Team A" OR "Team B" OR #WorldCup) lang:en -is:retweet
MATCH_PLAYER_TERMS=Messi,Mbappe,Kane,Bellingham,Donovan
X_MAX_RESULTS=80
X_REFRESH_SECONDS=45
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
